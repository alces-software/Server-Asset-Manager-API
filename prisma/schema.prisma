generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Log {
  id                Int      @id @default(autoincrement())
  userId            Int?
  timestamp         DateTime @default(now())
  endpoint          String   @db.VarChar(255)
  method            String   @db.VarChar(255)
  durationMs        Int?
  code              String?  @db.VarChar(255)
  requestSizeBytes  Int?
  responseSizeBytes Int?

  user User? @relation(fields: [userId], references: [id])

  @@map("Logs")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique(map: "name") @db.VarChar(255)
  users       User[]
  permissions Permission[]

  @@map("Roles")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique(map: "name") @db.VarChar(255)
  roles Role[]

  @@map("Permissions")
}

model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique(map: "username") @db.VarChar(255)
  passwordHash String            @db.Char(64)
  roleId       Int
  refreshToken UserRefreshToken?
  role         Role              @relation(fields: [roleId], references: [id], onUpdate: Restrict, map: "fk_users_role")
  logs         Log[]

  @@index([roleId], map: "fk_users_role")
  @@map("Users")
}

model UserRefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique(map: "userId")
  tokenHash String   @db.Char(64)
  expiresAt DateTime @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_refresh_user")

  @@map("UserRefreshTokens")
}

model Group {
  id     Int     @id @default(autoincrement())
  name   String  @unique(map: "name") @db.VarChar(255)
  assets Asset[]

  @@map("Groups")
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique(map: "name") @db.VarChar(255)
  assets Asset[]

  @@map("Tags")
}

model Asset {
  id          Int                         @id @default(autoincrement())
  groupId     Int?
  storageId   Int?
  name        String                      @db.VarChar(255)
  notes       String?                     @db.Text
  position    Int                         @default(0)
  json        AssetJson[]
  paths       AssetPath[]
  group       Group?                      @relation(fields: [groupId], references: [id], onUpdate: Restrict, map: "fk_assets_group")
  storage     Storage?                    @relation("StorageContents", fields: [storageId], references: [id], onUpdate: Restrict, map: "fk_assets_storage")
  pdu         PowerDistributionUnit?
  server      Server?
  storageType Storage?                    @relation("StorageAsset")
  ups         UninterruptiblePowerSupply?
  tags        Tag[]

  @@index([groupId], map: "idx_assets_group")
  @@index([storageId], map: "idx_assets_storage")
  @@map("Assets")
}

model Storage {
  id     Int     @id
  size   Int?
  assets Asset[] @relation("StorageContents")
  asset  Asset   @relation("StorageAsset", fields: [id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_storage_asset")

  @@map("Storages")
}

model Server {
  id    Int     @id
  model String? @db.VarChar(255)
  size  Int?
  asset Asset   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_server_asset")

  @@map("Servers")
}

model UninterruptiblePowerSupply {
  id       Int    @id
  capacity Float? @db.Float
  asset    Asset  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ups_asset")

  @@map("UninterruptiblePowerSupplies")
}

model PowerDistributionUnit {
  id          Int   @id
  outletCount Int?
  asset       Asset @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pdu_asset")

  @@map("PowerDistributionUnits")
}

model AssetPath {
  id      Int    @id @default(autoincrement())
  path    String @db.Text
  name    String @db.VarChar(255)
  assetId Int
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assetpath_asset")

  @@index([assetId], map: "idx_assetpaths_asset")
  @@map("AssetPaths")
}

model AssetJson {
  id         Int       @id @default(autoincrement())
  rawJson    String    @db.LongText
  uploadDate DateTime? @default(now()) @db.DateTime(0)
  assetId    Int
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assetjson_asset")

  @@index([assetId], map: "idx_assetjson_asset")
  @@map("AssetJson")
}

model Template {
  id    Int            @id @default(autoincrement())
  name  String         @unique(map: "name") @db.VarChar(255)
  paths TemplatePath[]

  @@map("Templates")
}

model TemplatePath {
  id         Int      @id @default(autoincrement())
  path       String   @db.Text
  name       String?  @db.VarChar(255)
  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_templatepath_template")

  @@index([templateId], map: "fk_templatepath_template")
  @@map("TemplatePaths")
}
