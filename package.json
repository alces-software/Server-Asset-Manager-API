{
   "name": "minimal-api",
   "version": "1.0.1",
   "main": "dist/index.js",
   "tsup": {
      "entry": [
         "src/index.ts"
      ],
      "outDir": "dist",
      "format": [
         "esm"
      ],
      "target": "es2022",
      "minify": true,
      "clean": true
   },
   "scripts": {
      "prod": "node index.js",
      "prod:install": "npm i --omit=dev",
      "build": "tsup src/index.ts && cp -r package.json .env prisma prisma.config.ts dist/",
      "dev": "tsx watch src/index.ts",
      "format": "prettier --write .",
      "lint": "eslint .",
      "postinstall": "prisma generate"
   },
   "keywords": [],
   "type": "module",
   "dependencies": {
      "@hono/node-server": "^2.0.12",
      "@hono/zod-validator": "^0.9.0",
      "@prisma/adapter-mariadb": "^7.9.1",
      "@prisma/client": "^7.9.1",
      "dotenv": "^17.4.2",
      "hono": "^4.12.32",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@types/node": "^26.1.2",
      "eslint": "^10.8.1",
      "prettier": "^3.9.6",
      "prisma": "^7.9.1",
      "tsup": "^8.5.1",
      "tsx": "^4.23.1",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.66.0"
   }
}
